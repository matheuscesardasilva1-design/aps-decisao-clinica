# ==============================================================================
# APS Decisão Clínica — Variáveis de Ambiente
# Copie este arquivo para .env.local (Next.js) e .env (scripts Python)
# ==============================================================================

# --- Supabase (Frontend + Backend) ---
# Encontre em: Supabase Dashboard -> Settings -> API
NEXT_PUBLIC_SUPABASE_URL="https://SEU-PROJETO.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="SUA_SUPABASE_ANON_KEY"

# --- Supabase Service Role (EXCLUSIVO BACKEND / PYTHON / GITHUB ACTIONS) ---
# NUNCA exponha esta chave com prefixo NEXT_PUBLIC_
SUPABASE_URL="https://SEU-PROJETO.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="SUA_SUPABASE_SERVICE_ROLE_KEY"

# --- Google Gemini API (EXCLUSIVO BACKEND / PYTHON / GITHUB ACTIONS) ---
# NUNCA exponha esta chave com prefixo NEXT_PUBLIC_
GEMINI_API_KEY="SUA_GEMINI_API_KEY"

# --- Opcional: Disparar GitHub Action manualmente pela tela /admin ---
# Se não configurado, o botão em /admin executa a captura leve diretamente via API Route
GITHUB_TOKEN=""
GITHUB_REPO=""
